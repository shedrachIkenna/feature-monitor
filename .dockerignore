# Only backend/, monitor/, frontend/, traffic/ code and scenarios, and the uv files are needed.
.git
.venv
.claude
**/__pycache__
.pytest_cache
.ruff_cache
data/
docs/
eval/
tests/
traffic/data/
traffic/runs/
*.db
*.db-shm
*.db-wal
# Rebuilt from Neuronpedia at build time, so a build never depends on a local cache.
monitor/labels_cache.json
monitor/baselines/*_features.json
monitor/baselines/*_embeddings.npy
