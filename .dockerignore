# Only backend/, monitor/, frontend/ and the uv files are needed to build the image.
.git
.venv
.claude
**/__pycache__
.pytest_cache
.ruff_cache
data/
docs/
eval/
tests/
traffic/
*.db
*.db-shm
*.db-wal
# Rebuilt from Neuronpedia at build time, so a build never depends on a local cache.
monitor/labels_cache.json
monitor/baselines/*_features.json
monitor/baselines/*_embeddings.npy
