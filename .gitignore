# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.ruff_cache/

# uv
.venv/
.uv/
uv-cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Model and framework caches
.cache/
model_cache/
models/cache/
huggingface/
transformers/
sae_lens/
torch/

# Local databases
*.db
*.db-shm
*.db-wal

# Generated local caches
monitor/labels_cache_*.json
# Generated traffic pools (recreate with: uv run python -m traffic.prepare_data)
traffic/data/
traffic/runs/

# Per-prompt features for threshold calibration (recreate with: uv run python -m monitor.calibrate)
monitor/baselines/*_features.json
# Prompt embeddings for the embedding detector (recreate with: uv run python -m monitor.embed_drift)
monitor/baselines/*_embeddings.npy
# Per-prompt features and clusters for the multi-seed replay (recreate with: uv run python -m eval.multiseed)
data/multiseed/
data/experiments/
