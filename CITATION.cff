    family-names: Nwali
repository-code: "https://github.com/shedrachIkenna/feature-monitor"
url: "https://huggingface.co/spaces/Shedrach/feature-monitor"
license: MIT
version: 0.1.0
date-released: "2026-10-19"
keywords:
  - sparse autoencoders
  - drift detection
  - interpretability
  - monitoring
